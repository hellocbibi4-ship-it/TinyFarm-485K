{
  "name": "TinyFarm Devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8080],
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylint",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements-test.txt"
}


